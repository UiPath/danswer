# Local secrets.env is GENERATED — don't hand-edit it:
#
#     k8s/scripts/dev-secrets.sh k8s
#
# renders it from the dev Key Vault (darwin-dev-kv) using your `az login`.
# It becomes the danswer-secrets Secret, mounted at /mnt/secrets and exported
# as env vars by base/secrets-loader.yaml — so keys must be the exact env var
# names. Anything not in the vault is simply unset (integrations no-op).
#
# Keys currently in darwin-dev-kv (vault names use '-' instead of '_'):
POSTGRES_PASSWORD=
USER_AUTH_SECRET=
GEN_AI_CLIENT_SECRET=
DANSWER_BOT_SLACK_APP_TOKEN=
DANSWER_BOT_SLACK_BOT_TOKEN=
#
# Non-secret identifiers (POSTGRES_USER, OAUTH_CLIENT_ID, GEN_AI_CLIENT_ID, ...)
# belong in env.properties, not here.
