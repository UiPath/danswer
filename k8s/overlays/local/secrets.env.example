# Template for YOUR personal local-dev secrets file. Copy it, fill it in:
#
#     cp k8s/overlays/local/secrets.env.example ~/.darwin-dev.env
#     chmod 600 ~/.darwin-dev.env
#
# Used by k8s/scripts/dev-secrets.sh: `export` mode feeds dapi/dbe/dsl,
# `k8s` mode renders this overlay's secrets.env (gitignored) from it. Keys are
# the exact env var names; KEY=VALUE, no quotes. Leave out what you don't use
# (integrations no-op when unset). Never commit real values.

# Your local Postgres (docker) password
POSTGRES_PASSWORD=
# Any long random string, e.g. `openssl rand -hex 32`
USER_AUTH_SECRET=

# --- Shared team credentials: ask a teammate for the current values ---
# Login: dex-oauth's "local-dev-only" client secret (expires every 90 days)
OAUTH_CLIENT_SECRET=
# UiPath LLM gateway client secret (non-prod)
GEN_AI_CLIENT_SECRET=

# --- Optional: your own dev Slack app (don't share one bot between devs:
# Socket Mode splits events across everyone connected) ---
DANSWER_BOT_SLACK_APP_TOKEN=
DANSWER_BOT_SLACK_BOT_TOKEN=

# Non-secret identifiers (POSTGRES_USER, OAUTH_CLIENT_ID, GEN_AI_CLIENT_ID, ...)
# belong in env.properties / your shell, not here.
